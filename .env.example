# ==============================================================================
# BLACK GRAPES SOFTECH — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# Never commit credentials, private API keys, or secrets into source control.

# Application Base URL
NEXT_PUBLIC_SITE_URL=https://blackgrapessoftech.com

# Node Environment (automatically set by Next.js / Vercel)
NODE_ENV=production

# Optional: Google Analytics / Tag Manager Measurement ID
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Dedicated Webhook / SMTP Endpoint for Contact Inquiries
# CONTACT_INQUIRY_WEBHOOK_URL=https://api.example.com/webhook/contact

